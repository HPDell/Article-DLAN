@article{HuangShi-2023,
  title = {{城市更新抑制房价快速增长了吗？------基于广东省``三旧''改造实践的实证研究}},
  author = {黄, 志基 and 石, 涛 and 易, 成栋 and 陈, 敬安},
  year = 2023,
  month = mar,
  journal = {中国管理科学},
  pages = {1--16},
  issn = {1003-207X},
  doi = {10.16381/j.cnki.issn1003-207x.2021.2442},
  abstract = {在土地资源约束趋紧和住房价格过快增长的双重压力下，合理调控房价成为政策制定者和学界关注的焦点。现有研究主要从增量发展视角探究房价调控的可能措施，还较少关注进入存量发展阶段后房价可能的发展趋势及调控机制。本文利用广东省2009---2019年城市面板数据，基于存量发展视角，研究``三旧''改造对广东省城市房价增长率的影响。结果表明：\ding{172}``三旧''改造实践显著抑制了房价过快增长，并且非珠三角地区比在珠三角地区呈现出更为显著的抑制性作用；\ding{173}调节效应表明，土地财政压力越小和存量开发动力越高的城市，其房价增长率受``三旧''改造抑制的程度越大；\ding{174}机制检验表明，``三旧''改造通过增加房屋供给与降低地方政府土地出让金收入增长率两种途径，抑制了房价增长率上升。本文首次从城市与区域视角，验证了城市更新对房价快速增长的抑制作用，为未来推进城市更新和城市房价的调控提供了新的决策参考。},
  langid = {chinese},
