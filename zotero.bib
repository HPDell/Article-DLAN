@misc{LiuGoudie-2022,
  title = {Generalized Geographically Weighted Regression Model within a Modularized Bayesian Framework},
  author = {Liu, Yang and Goudie, Robert J. B.},
  year = 2022,
  month = feb,
  number = {arXiv:2106.00996},
  eprint = {2106.00996},
  primaryclass = {stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2106.00996},
  urldate = {2025-12-26},
  abstract = {Geographically weighted regression (GWR) models handle geographical dependence through a spatially varying coefficient model and have been widely used in applied science, but its general Bayesian extension is unclear because it involves a weighted log-likelihood which does not imply a probability distribution on data. We present a Bayesian GWR model and show that its essence is dealing with partial misspecification of the model. Current modularized Bayesian inference models accommodate partial misspecification from a single component of the model. We extend these models to handle partial misspecification in more than one component of the model, as required for our Bayesian GWR model. Information from the various spatial locations is manipulated via a geographically weighted kernel and the optimal manipulation is chosen according to a Kullback-Leibler (KL) divergence. We justify the model via an information risk minimization approach and show the consistency of the proposed estimator in terms of a geographically weighted KL divergence.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Statistics - Methodology},
  file = {C\:\\Users\\HuYG0\\OneDrive\\Papers\\2022.Liu.Generalized geographically weighted regression model within a modularized bayesian framework.pdf;C\:\\Users\\HuYG0\\Zotero\\storage\\YKXSCB28\\2106.html}
}

