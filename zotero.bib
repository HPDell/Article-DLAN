  doi = {10.1080/24694452.2025.2591684},
  abstract = {We introduce GALAX (Geospatial Analysis Leveraging AutoML and eXplainable AI), an enhanced geographically weighted regression (GWR) framework integrating automated machine learning (AutoML) and explainable artificial intelligence (XAI). GALAX employs AutoML to automatically optimize the best machine learning models for different geographic regions and XAI, via SHapley Additive Explanations, to provide localized interpretability through systematic quantification of feature contributions. GALAX can capture nonstationary and nonlinear relationships, analyze high-dimensional feature spaces, and support both regression and classification applications. We validate GALAX through mobility pattern analyses within the Philadelphia Metropolitan Statistical Area. For regression, GALAX outperforms GWR and geographical random forests (GRF) with root mean square error reductions of 36.0 percent and 44.0 percent, and R2 improvements of 21.5 percent and 38.2 percent, respectively. GALAX reveals nonlinear relationships and spatial heterogeneity in factor importance, with median household income showing generally positive correlation with mobility distance, with a more moderate slope above \$150,000, and being the dominant factor in suburban areas. For classification, GALAX achieves higher accuracy than GRF, uncovering spatial variations, nonlinear relationships between factors and mobility categories, and specific threshold effects missed by linear models. GALAX bridges machine learning and traditional geographical methods, offering new possibilities for analyzing spatial phenomena while maintaining interpretability.},
  langid = {english},
  keywords = {automated machine learning,explainable AI,geographically weighted regression,GEOGRAPHICALLY WEIGHTED REGRESSION,GWR,human mobility,MODELS,PATTERNS,SHAP},
  annotation = {Web of Science ID: WOS:001639554200001}
}

@phdthesis{WangZengZheng-2025,
  type = {{博士学位论文}},
  title = {{顾及空间离散异质性的多尺度区域地理加权回归方法}},
  author = {王, 增铮},
  year = 2025,
  doi = {10.27414/d.cnki.gxnju.2023.000137},
  urldate = {2026-03-01},
  abstract = {地理加权回归方法是地理空间大数据建模研究的前沿问题之一。通过拓展地理加权回归方法来增强空间关系的分析能力,对理解地理过程或社会现象并辅助精准施策具有重要的理论和实践价值。空间关系的异质性也被称为空间非平稳性,是回归过程中要考虑的关键因素,包括空间离散异质性和连续异质性两个核心要素,其中离散异质性描述了地理过程在不同空间单元之间的非线性特征。 探测离散异质性的基础是对离散异质区域进行量化区分,然而,现行的空间划分方法往往基于距离度量或者单一属性变量,部分方法考虑了不同的变量,仅是给变量赋予不同的权重,忽视了不同变量的相互作用和影响,导致无法准确划分特定地理过程下的离散异质区。另一方面,地理加权回归方法是建立在``临近相关''假设前提下的一种有效探测空间连续异质性的方法,但地理空间中存在``临近异质''的空间离散情况。地理加权回归无法充分拟合这种非线性特征,导致其在解算离散异质性时面临区域临界处拟合不充分、回归系数估计偏差大等问题,影响了模型的准确性和可靠性。 针对上述问题,本文提出了顾及空间离散异质性的多尺度区域地理加权回归方法。通过研究综合变量间相互作用和多尺度的空间自适应层次二分聚类方法,实现面向不同地理过程的离散异质区最优划分,形成解算离散异质性的分区基础;然后重点研究融合离散异质区距离度量的空间权重优化和区域地理加权回归方法,提升模型在区域临界处的拟合效果;在此基础上,结合区域空间权重和灵活带宽策略,提出多尺度区域地理加权回归方法,提升模型回归系数的估计精度和整体拟合优度;最后以房地产销售价格与特征变量的空间关系建模为例,进行测试与验证分析。主要研究内容如下: （1）构建了综合变量间相互作用和多尺度的空间自适应层次二分聚类方法。首先,考虑不同地理过程下多变量的相互作用和影响,基于地理加权回归空间权重的计算特性,重新定义距离度量函数,优化初始聚类中心的选择方式,建立区域内离散异质区二分聚类流程;然后,基于空间尺度变化的视角,在Fisher最优划分法的基础上,研究离散异质区域直径与分区损失函数的定义以及递推公式,完成层内划分和最优分层数的自适应确定;最后,融合上述方法构建空间自适应层次二分聚类方法和算法流程,实现面向不同地理过程的离散异质区最优划分。 （2）建立了融合离散异质区距离度量的空间权重优化方法。首先,针对现有地理加权回归方法对离散异质性解算精度不高、区域临界处拟合不充分等问题,考虑离散异质区之间相互影响程度,建立区域距离度量和影响因子测算方法,进而对空间核函数进行修正,构建区域空间权重,实现空间权重的优化;然后,探讨区域空间权重的特殊表现形式,给出该形式下区域影响因子探测方法,使用区域空间权重矩阵建立区域地理加权回归方法,构建对比分析算法流程;最后,采用真实数据进行验证。结果表明,区域地理加权回归方法在拟合优度和区域临界处的拟合效果均优于地理加权回归方法。 （3）提出了结合区域空间权重和灵活带宽策略的多尺度区域地理加权回归方法,首先,顾及回归变量在空间上并非都具有离散异质性的特征,引入区域变量,为区域变量构建区域空间权重,将对应的回归系数定义为区域变系数,探讨区域变系数和常规系数的估计方法;然后,在此基础上考虑多变量在不同尺度上对地理过程产生不同影响的现象,融合灵活带宽策略,提出了多尺度区域地理加权回归方法,并基于反向拟合算法（back-fitting）推导了估计方法,实现融合区域变量和多尺度带宽的复杂空间异质性的解算;最后,通过模拟数据和真实数据对方法进行验证。结果表明,本方法在估计回归系数方面优于区域地理加权回归和多尺度地理加权回归方法,并且进一步提高了模型的整体拟合优度。 （4）运用上述研究成果,选取受特征变量在不同尺度下影响的北京市住宅挂牌销售价格为典型案例,基于空间自适应层次二分聚类方法划分的离散异质区,构建住宅销售价格与特征变量的空间关系模型。在论证离散异质区划分效果的基础上,对模型性能进行验证分析。结果表明,多尺度区域地理加权回归模型的R\textsuperscript{2}比地理加权回归模型提升了15.1\%,MSE比地理加权回归模型降低了53.24\%,证明本文提出的方法能够有效提高模型的拟合效果。最后,探讨并分析了北京市房价和影响因素的空间格局分布,从空间离散的角度对特征变量影响力的空间分布做出不同视角的解读,增强对不同特征变量属性变化空间模式的解释。},
  collaborator = {朱, 军 and 张, 福浩},
  langid = {chinese},
  school = {西南交通大学},
  annotation = {major: 测绘科学与技术\\
download: 276\\
album: 基础科学;信息科技\\
CLC: P208\\
dbcode: CDFD\\
dbname: CDFDLAST2025\\
filename: 1024489390.nh}
}

@article{WangZhang-,
  title = {Efficient Inference of Large-Scale Air Quality Using a Lightweight Ensemble Predictor},
  author = {Wang, Peixiao and Zhang, Hengcai and Liu, Jie and Lu, Feng and Zhang, Tong},
  journal = {International Journal of Geographical Information Science},
  volume = {0},
  number = {0},
  pages = {1--25},
  publisher = {Taylor \& Francis},
  issn = {1365-8816},
  doi = {10.1080/13658816.2024.2437044},
  urldate = {2025-02-01},
  abstract = {Accurate and efficient air quality prediction is crucial for public health protection and environmental sustainability. While numerous grid-based and graph-based prediction models have been developed, they encounter challenges in large-scale scenarios: (1) Grid-based models, though computationally efficient, have limited prediction accuracy in large-scale sparse scenarios; (2) Graph-based models, despite higher prediction accuracy, suffer from significant computational inefficiencies when dealing with a large number of sensors, i.e. graph nodes. To address these issues, we propose a Lightweight Ensemble Predictor (LiEnPred) for efficient air quality prediction in large-scale sparse scenarios. First, we present a data structure transformation algorithm that converts sparse monitoring sensors from graph structures to compact grid structures, preserving the connections between graph nodes. Next, we present a lightweight parameter-shared spatio-temporal dilation convolution network that efficiently captures spatio-temporal dependencies in air quality data without significantly increasing computation time or parameter scale. In our experiments, we collected air quality data from over 2000 sensors across China over the past three years and evaluated LiEnPred's prediction performance in large-scale scenarios using PM2.5 and NO2 concentration data. The experimental results demonstrate that the proposed LiEnPred model matches or exceeds the predictive accuracy of eight baselines with faster time efficiency and fewer model parameters.},
  langid = {english},
  keywords = {Air quality prediction,computationally efficient model,large-scale,sparse scenario},
  file = {C:\Users\HuYG0\OneDrive\Papers\Wang.Efficient inference of large-scale air quality using a lightweight ensemble predictor.pdf}
}

