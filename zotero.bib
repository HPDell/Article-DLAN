  shorttitle = {Explore {{Big Data Analytics Applications}} and {{Opportunities}}},
  author = {{Al-Sai}, Zaher Ali and Husin, Mohd Heikal and {Syed-Mohamad}, Sharifah Mashita and Abdin, Rasha Moh'd Sadeq and Damer, Nour and Abualigah, Laith and Gandomi, Amir H.},
