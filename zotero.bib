@article{Zhang-2024,
  title = {An Investigation of the Differences in Education between China's Urban and Rural Areas from the Standpoint of Educational Equity},
  author = {Zhang, Yiqin},
  year = 2024,
  journal = {Lecture Notes in Education Psychology and Public Media},
  doi = {10.54254/2753-7048/39/20240700},
  urldate = {2024-12-15},
  abstract = {At present, there is a significant difference between urban and rural education in China, which is not only reflected in the quality of education but also family education, education concept, family capital, allocation and utilization of educational resources, etc. Under the influence of various factors, the current situation of rural education is not optimistic, and the difference between rural education and urban education is even increasing. In addition to effectively promoting the development of rural education, achieving a balanced development of education and narrowing the gap in regional education is also conducive to achieving educational equity and harmonious development of education in the whole society. Starting from the current situation of the urban-rural education gap in China, this paper examines the impact of the urban-rural economic, cultural and policy gap, and proposes specific measures to reduce the gap. These include balancing the input of urban and rural education, enhancing rural education resources with the aid of information technology, and enacting government policies that support rural education.},
  langid = {english},
  file = {C\:\\Users\\HuYG0\\OneDrive\\Papers\\2024.Zhang.An investigation of the differences in education between china's urban and rural areas from the stan.pdf;C\:\\Users\\HuYG0\\Zotero\\storage\\ZCZ7LK4I\\0fed807e6ef35b999fd1f0d5110be75a.html}
}

