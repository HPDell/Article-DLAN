@phdthesis{Wu-2012b,
  type = {{硕士}},
  title = {{中学特长生家庭背景的调查研究------基于布迪厄资本理论的分析视角}},
  author = {吴, 大鹏},
  year = 2012,
  address = {南京},
  abstract = {本研究在实证调查的基础上,采用了对比研究的方法,分析对比了特长生与普通学生的家庭经济资本、文化资本及社会资本的差异。结果显示：特长生与普通学生的家庭经济资本的差异性显著,家庭文化资本的差异性显著,家庭社会资本没有显著性差异。这在一定程度上说明了家庭经济资本与文化资本对特长的形成及特长生身份的获得都是有较大影响的。 	同时,也把艺术、体育、科技三种类型的特长生分别与普通学生进行了对比分析。结果显示：艺术特长生与普通学生的家庭经济资本的差异性显著,家庭文化资本的差异性显著,家庭社会资本没有显著性差异；体育特长生与普通学生的家庭经济资本没有显著性差异,家庭文化资本没有显著性差异,家庭社会资本也没有显著性差异；科技特长生与普通学生的家庭经济资本的差异性显著,家庭文化资本没有显著差异,家庭社会资本有显著性差异。这在一定程度上说明了家庭经济资本与文化资本对艺术特长的形成及艺术特长生身份的获得有较大影响；家庭经济资本、文化资本及社会资本对体育特长的形成及体育特长生身份的获得没有显著性的影响；家庭经济资本与社会资本对科技特长的形成及科技特长生身份的获得有较大影响。 	以上的研究结果又共同说明了一个问题：家庭资本对特长的形成及特长生身份的获得是有着重要影响的。而在社会分层下的资本占有是严重不均的,不同的社会阶层占有的资本数量不一样,这就意味着他们所能支配和动用的资本额度不同。在孩子特长的形成及特长生身份的获取上,中上层可以动用更多的资本,而底层的家庭没有更多的资本可以动用,这在很大程度上就挤压与剥夺了底层及中下层家庭的孩子获取特长生身份和获得特长生待遇的权利。特长教育及特长生待遇是国家给予所有群体的权利,在资本的运作下很可能就变成了社会中上层的一种特权。而在研究中,笔者又发现了一个有趣且值得探讨的问题。在特长生中,家庭特别有钱有势并不是很多,就是说那些社会上层对特长生并没有想象的那么热衷,而真正对特长生教育充满热情的是中间阶层。根据已有的研究和笔者对一些中产阶层的访谈,笔者认为中产阶层之所以对教育及特长生教育如此热衷,主要有以下几点因素：1、中间阶层对自身及子女地位的焦虑2、攀比与从众的普遍心理3、中产阶层的阶层惯习4、特长被中产阶级视为一种资本。总而言之,中产阶层由于自身的特殊性,成为了特长教育最大的支持者。},
  langid = {chinese},
  school = {南京师范大学},
  keywords = {,/unread,Cultural capital,Economic capital,Family background,Social capital,Social class,talented students}
}

