@article{ChakraborttyPal-2020,
  title = {Soil Erosion Potential Hotspot Zone Identification Using Machine Learning and Statistical Approaches in Eastern {{India}}},
  author = {Chakrabortty, Rabin and Pal, Subodh Chandra and Sahana, Mehebub and Mondal, Ayan and Dou, Jie and Binh, Thai Pham and Yunus, Ali P.},
  year = 2020,
  month = nov,
  journal = {Natural Hazards},
  volume = {104},
  number = {2},
  pages = {1259--1294},
  publisher = {Springer},
  address = {New York},
  issn = {0921-030X, 1573-0840},
  doi = {10.1007/s11069-020-04213-3},
  abstract = {Land degradation is very severe in the subtropical monsoon-dominated region due to the uncertainty of rainfall in the long term, and most of the rainfall occurs with high intensity and kinetic energy over short time periods. So, keeping this scenario in view, the main objective of this work is to identify areas vulnerable to soil erosion and propose the most suitable model for soil erosion susceptibility in subtropical environment. The implementation of machine learning and artificial intelligence techniques with a GIS environment for determining erosion susceptibility is highly acceptable in terms of optimal accuracy. The point-specific values of different elements from random sampling were considered for this study. Sensitivity analysis of the predicted models (i.e., analytical neural network, geographically weighted regression and GWR-ANN ensemble) was performed using the maximum causative factors and related primary field observations. The area under curve of receiver operating system reveals precision with 87.13, 89.57 and 91.64 for GWR, ANN and ensemble GWR-ANN, respectively. The ensemble GWR-ANN is more optimal than the GWR, ANN for determining water-induced soil erosion susceptibility. The process of soil erosion is not a unidirectional process, so the multidimensional impacts from the conditioning factors have to be determined precisely by considering the maximum possible factors as well as selecting optimal models for specific regions.},
  langid = {english},
  keywords = {Ensemble GWR-ANN,GEOGRAPHICALLY WEIGHTED REGRESSION,GIS,GULLY EROSION,Land degradation,LAND-USE,LANDSLIDE SUSCEPTIBILITY,LOGISTIC-REGRESSION,RANDOM FOREST,Random sampling,SEDIMENT YIELD,Soil erosion,SUSCEPTIBILITY ASSESSMENT,TIME-SERIES,Unidirectional process},
  annotation = {Web of Science ID: WOS:000556678600004}
}

@article{ChakrabortyNovotny-2022,
  title = {Geography Matters for Sanitation! {{Spatial}} Heterogeneity of the District-Level Correlates of Open Defecation in {{India}}},
  author = {Chakraborty, Saurav and Novotn{\'y}, Josef and Das, Jadab and Bardhan, Aditi and Roy, Srijanee and Mondal, Swikriti and Patel, Priyank Pravin and Santra, Sneha and Maity, Indranil and Biswas, Rimi and Maji, Aparajita and Pramanik, Suvamoy},
  year = 2022,
  journal = {Singapore Journal of Tropical Geography},
  volume = {43},
  number = {1},
  pages = {62--84},
  issn = {1467-9493},
  doi = {10.1111/sjtg.12402},
  urldate = {2024-04-05},
  abstract = {This paper quantitatively analyzes the spatial heterogeneity of district-level correlates of open defecation in rural India. We employ standard non-spatial regression, spatially explicit regressions and multi-scale geographically weighted regression to compare the stability of measurable correlates of open defecation across these different methods as well as across analyzed spatial units. Attributes like ownership of household assets, drinking water inaccessibility and prevalent literacy rates were identified as the most stable district-level correlates of open defecation. Our results also demonstrated the relevance of our hypotheses about (a) possible negative sanitation externalities stemming from the co-concentration of Scheduled Caste communities and other communities in densely populated rural districts, and (b) possible positive sanitation externalities stemming from the co-concentration of Muslim and non-Muslim communities in densely populated districts. Overall, however, our analyses demonstrate notable spatial clustering and significant spatial non-stationarity of examined variables. Therefore, in our opinion, research findings that ignore spatial heterogeneity of sanitation drivers provide incomplete information for policy development and implementation.},
  copyright = {\copyright{} 2021 Department of Geography, National University of Singapore and John Wiley \& Sons Australia, Ltd.},
  langid = {english},
  keywords = {/unread,environmental health,multi-scale geographically weighted regression,open defecation,sanitation externalities,spatial heterogeneity},
  file = {C:\Users\HuYG0\OneDrive\Papers\2022.Chakraborty.Geography matters for sanitation.pdf}
}

@article{ChangHu-2022,
  title = {Effectiveness and Heterogeneity Evaluation of Regional Collaborative Governance on Haze Pollution Control: {{Evidence}} from 284 Prefecture-Level Cities in {{China}}},
  shorttitle = {Effectiveness and Heterogeneity Evaluation of Regional Collaborative Governance on Haze Pollution Control},
  author = {Chang, Yonglian and Hu, Peipei and Huang, Yingjun and Duan, Zhengmin},
  year = 2022,
  month = nov,
  journal = {Sustainable Cities and Society},
  volume = {86},
  pages = {104120},
  issn = {2210-6707},
  doi = {10.1016/j.scs.2022.104120},
  urldate = {2022-11-09},
  abstract = {The impact of collaborative governance on the reduction of haze pollution has always been a hotly debated topic in environmental protection research. First, the present study aims to examine the effectiveness of collaborative governance on haze pollution control by using panel data of 284 Chinese cities during 2008--2018. Second, social network analysis is used to divide 31 provinces into 10 collaborative governance regions. Third, the temporal and spatial heterogeneity of collaborative governance on the reduction of haze pollution in each region is investigated through the GTWR model, and the underlying mechanism of the heterogeneity of collaborative governance is explained in detail through the ``free-rider'' effect. The results show that collaborative governance has a positive effect on haze pollution reduction, in which government effort is indispensable. The concentration of PM2.5 decreased by 5.658~{$\mu$}g/m3 with every 1\% increase in the collaborative governance level. The collaborative governance effect shows an obvious time trend and regional difference, and the effect of haze control in each collaborative governance region basically shows a fluctuating trend due to the updating of environmental regulations. The developed regions have better control effect in haze pollution control, and the eastern coastal regions are better than other regions. The temporal and spatial distribution characteristics of the ``free-rider'' effect are similar to those of collaborative governance; the "free-rider" effect is more apparent in less-developed areas and areas with special terrain. Central government supervision is essential for enhancing regional collaborative governance and avoiding the ``free-rider'' effect. At the same time, it is necessary to improve regional collaborative governance through the clear division of responsibilities and regulatory rules.},
  langid = {english},
  keywords = {Collaborative governance,GTWR,Haze pollution,Heterogeneity,The "free-rider" effect},
  file = {C:\Users\HuYG0\Zotero\storage\49MKZ9ZW\S2210670722004334.html}
}

