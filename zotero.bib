@phdthesis{Hu-2021,
  type = {{硕士学位论文}},
  title = {{时空地理加权密度回归模型及其应用}},
  author = {胡, 奕公},
  year = 2021,
  address = {武汉},
  urldate = {2025-04-07},
  abstract = {地理加权回归模型及相应的扩展模型(如时空地理加权回归模型、周期性时空地理加权回归模型)是分析空间异质性的重要方法,已经得到了广泛应用。但是这些模型都采用一元距离度量和一元核函数作为地理加权的依据,导致模型中的各向异性被忽略、时空距离定义不合理、线数据之间距离的定义不合理等问题,对于空间重采样数据进行分析时忽略了``组内同质、组间异质''的现象。本文通过提出时空地理加权密度回归和分层线性与时空地理加权复合模型,分别解决传统模型中在处理空间单采样数据与空间重采样数据中面临的这些问题。主要研究内容包括:(1)时空地理加权密度回归模型。在以条件随机变量定义空间变量和空间异质性的基础上,基于核密度估计和密度回归方法定义空间核密度估计,提出时空地理加权密度回归模型地解算方法和诊断方法,针对时空大数据分解了诊断变量计算中所使用的大型密集矩阵。提出模型优选方法,包括变量优选和带宽优选。该模型与传统GWR模型形式相似,但二者针对的位置空间不同、加权方法不同、求解方法不同,时空地理加权密度回归模型是传统GWR模型的扩展和延申。 (2)分层线性与时空地理加权复合模型。将时空地理加权密度回归模型应用于空间重采样数据时,模型在带宽优选、系数估计时会出现较多问题,使结果出现异常。针对这一问题及空间分层数据中``组内同质、组间异质''的特点,提出分层线性与时空地理加权复合模型。在分层线性模型求解过程的基础上给出该复合模型的求解方法,以及变量优选的方法。(3)模型在高维复杂空间单采样数据和空间重采样数据中的应用对于空间单采样数据,从理论上和实验中分析时空地理加权密度回归模型在分析普通时空数据、周期性时空数据、空间交互数据时与相应的已有模型的区别。对于空间重采样数据,通过武汉市二手房市场价格影响因子分析的案例研究,分析了分层线性与时空地理加权复合模型的拟合能力和估计效果。 模拟实验和案例研究表明,时空地理加权密度回归模型提供了进行空间异质性分析的模型框架,与传统模型相比具有更好的拟合能力,其回归系数估计结果更复合预期。武汉市二手房市场价格影响因子分析的案例研究表明,分层线性与时空地理加权复合模型可以较大程度上避免传统GWR模型时出现的带宽优选的问题,避免回归系数估计值中存在的一些不合理的现象,得到更为符合预期的估计结果。},
  collaborator = {李, 建松 and 卢, 宾宾},
  langid = {chinese},
  school = {武汉大学},
  annotation = {major: 地图学与地理信息系统\\
download: 20\\
