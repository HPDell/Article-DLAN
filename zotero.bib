  doi = {10.1016/j.healthplace.2022.102871},
  urldate = {2026-03-02},
  abstract = {While social and spatial determinants of biomarkers have been reported, no previous study has examined both together within an intersectional perspective. We present a novel extension of quantitative intersectional analyses using cross-classified multilevel models to explore how intersectional positions and neighbourhood deprivation are associated with biomarkers, using baseline UK Biobank data (collected from 2006 to 2010). Our results suggest intersectional inequalities in biomarkers of healthy ageing are mostly established by age 40--49, but different intersections show different relationships with deprivation. Our study suggests that certain biosocial pathways are more strongly implicated in how neighbourhoods and intersectional positions affect healthy ageing than others.},
  langid = {english},
  keywords = {Biomarkers,Chronic disease,Healthy ageing,Index of multiple deprivation,Intersectionality,Neighbourhood deprivation},
  file = {C\:\\Users\\HuYG0\\OneDrive\\Papers\\2022.Holman.Neighbourhood deprivation and intersectional inequalities in biomarkers of healthy ageing in England.pdf;C\:\\Users\\HuYG0\\Zotero\\storage\\FEYBH9TJ\\S1353829222001320.html}
}

@article{HongLiu-2017,
  title = {A Novel Hybrid Integration Model Using Support Vector Machines and Random Subspace for Weather-Triggered Landslide Susceptibility Assessment in the Wuning Area (China)},
  author = {Hong, Haoyuan and Liu, Junzhi and Zhu, A.-Xing and Shahabi, Himan and Binh, Thai Pham and Chen, Wei and Pradhan, Biswajeet and Dieu, Tien Bui},
  year = 2017,
  month = oct,
  journal = {Environmental Earth Sciences},
  volume = {76},
  number = {19},
  pages = {652},
  publisher = {Springer},
  address = {New York},
  issn = {1866-6280, 1866-6299},
  doi = {10.1007/s12665-017-6981-2},
  abstract = {This study proposed a hybrid modeling approach using two methods, support vector machines and random subspace, to create a novel model named random subspacebased support vector machines (RSSVM) for assessing landslide susceptibility. The newly developed model was then tested in the Wuning area, China, to produce a landslide susceptibility map. With the purpose of achieving the objective of the study, a spatial dataset was initially constructed that includes a landslide inventory map consisting of 445 landslide regions. Then, various landslide-influencing factors were defined, including slope angle, aspect, altitude, topographic wetness index, stream power index, sediment transport index, soil, lithology, normalized difference vegetation index, land use, rainfall, distance to roads, distance to rivers, and distance to faults. Next, the result of the RSSVM model was validated using statistical index-based evaluations and the receiver operating characteristic curve approach. Then, to evaluate the performance of the suggested RSSVM model, a comparison analysis was performed to other existing approaches such as artificial neural network, Naive Bayes (NB) and support vector machine (SVM). In general, the performance of the RSSVM model was better than the other models for spatial prediction of landslide susceptibility. The AUC results of the applied models are as follows: RSSVM (AUC = 0.857), followed by MLP (AUC = 0.823), SVM (AUC = 0.814) and NB (AUC = 0.783). The present study indicates that RSSVM can be used for landslide susceptibility evaluation, and the results are very useful for local governments and people living in the Wuning area.},
  langid = {english},
  keywords = {DECISION TREE,FREQUENCY RATIO,GEOGRAPHICALLY WEIGHTED REGRESSION,GIS,HAZARD ASSESSMENT,INFERENCE SYSTEM ANFIS,Landslides,LANTAU ISLAND,LOGISTIC-REGRESSION,Random subspace,SHALLOW LANDSLIDES,SPATIAL PREDICTION,SUBMARINE LANDSLIDES,Support vector machines},
  annotation = {Web of Science ID: WOS:000412736700008}
}

@article{HongSu-2022,
  title = {{城市更新项目对周边住宅价格的影响研究------以深圳市为例}},
  author = {洪, 竞科 and 苏, 妍 and 傅, 晏},
  year = 2022,
  journal = {现代城市研究},
  number = {2},
  pages = {112--117},
  issn = {1009-6000},
  abstract = {城市更新作为当今各大城市发展核心战略之一，能够提升区域的经济、社会和环境效益，而其对区域周边住宅价格的影响亟待深入讨论。论文以深圳市为例，基于2019年6---7月深圳市城市更新项目周边1002个住宅二手房挂牌单价数据，在传统特征价格模型的框架下，将城市更新特征引入模型进行拟合，并结合回归结果与边际价格分析了深圳市城市更新对周边住宅价格的总体影响。研究结果表明：住宅周边的城市更新项目对其价格具有显著增值作用，且该增值作用随项目数量、项目容积率、公司注册资本递增，而随项目距离递减；从影响程度来看，商业项目{$>$}居住项目{$>$}工业项目，不同类型项目对周边住宅价格影响的途径也各不相同。},
  langid = {chinese},
  keywords = {,hedonic price model,housing prices,Shenzhen,urban renewal},
  annotation = {2 citations(CNKI)[17-03-2023]{$<$}北大核心{$>$}},
  file = {C:\Users\HuYG0\Zotero\storage\NURCYTIZ\2022.洪.城市更新项目对周边住宅价格的影响研究——以深圳市为例.pdf}
}

@article{HongWang-2022,
  title = {Introducing Bootstrap Test Technique to Identify Spatial Heterogeneity in Geographically and Temporally Weighted Regression Models},
  author = {Hong, Zhimin and Wang, Jiayuan and Wang, Huhu},
  year = 2022,
  month = oct,
  journal = {Spatial Statistics},
  volume = {51},
  pages = {100683},
  issn = {2211-6753},
  doi = {10.1016/j.spasta.2022.100683},
  urldate = {2024-03-06},
  abstract = {In this paper, an extended mixed geographically and temporally weighted regression (EMixed-GTWR) model is proposed to capture the fusion of the temporal stationarity and spatio-temporal heterogeneity in a regression relationship. A residual-based bootstrap test method is introduced to detect the spatially varying coefficients in a geographically and temporally weighted regression (GTWR) model. Since the spatially and spatio-temporally varying coefficients cannot be estimated simultaneously, a two-step procedure is applied to estimating both regression coefficients. Both global homogeneity and spatial heterogeneity in a GTWR model can be detected by the proposed bootstrap test technique. The two simulation experiments with comparison to the existing test methods and models are performed to evaluate the performance of the proposed test and model, including the accuracy of the bootstrap test in approximating the null distribution of the test statistic, the power in identifying the spatio-temporally varying coefficients and the accuracy of the EMixed-GTWR model estimation to the coefficients. The simulation results demonstrate that the bootstrap test and the EMixed-GTWR model work well. Furthermore, a real data experiment is analyzed to illustrate the application of the bootstrap test technique and the EMixed-GTWR model.},
  keywords = {Bootstrap test,Geographically and temporally weighted regression,Hand foot and mouth disease,Spatial heterogeneity,Spatio-temporal heterogeneity},
  file = {C\:\\Users\\HuYG0\\OneDrive\\Papers\\2022.Hong.Introducing bootstrap test technique to identify spatial heterogeneity in.pdf;C\:\\Users\\HuYG0\\Zotero\\storage\\3S6CFQF9\\S2211675322000501.html}
}

@article{HongZhang-2019,
  title = {Impacts of Climate Change on Future Air Quality and Human Health in {{China}}},
  author = {Hong, Chaopeng and Zhang, Qiang and Zhang, Yang and Davis, Steven J. and Tong, Dan and Zheng, Yixuan and Liu, Zhu and Guan, Dabo and He, Kebin and Schellnhuber, Hans Joachim},
  year = 2019,
  month = aug,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {116},
  number = {35},
  pages = {17193--17200},
  publisher = {Proceedings of the National Academy of Sciences},
  doi = {10.1073/pnas.1812881116},
  urldate = {2024-01-24},
  abstract = {摘要 In recent years, air pollution has caused more than 1 million deaths per year in China, making it a major focus of public health efforts. However, future climate change may exacerbate such human health impacts by increasing the frequency and duration of weather conditions that enhance air pollution exposure. Here, we use a combination of climate, air quality, and epidemiological models to assess future air pollution deaths in a changing climate under Representative Concentration Pathway 4.5 (RCP4.5). We find that, assuming pollution emissions and population are held constant at current levels, climate change would adversely affect future air quality for {$>$}85\% of China's population ({$\sim$}55\% of land area) by the middle of the century, and would increase by 3\% and 4\% the population-weighted average concentrations of fine particulate matter (PM2.5) and ozone, respectively. As a result, we estimate an additional 12,100 and 8,900 Chinese (95\% confidence interval: 10,300 to 13,800 and 2,300 to 14,700, respectively) will die per year from PM2.5 and ozone exposure, respectively. The important underlying climate mechanisms are changes in extreme conditions such as atmospheric stagnation and heat waves (contributing 39\% and 6\%, respectively, to the increase in mortality). Additionally, greater vulnerability of China's aging population will further increase the estimated deaths from PM2.5 and ozone in 2050 by factors of 1 and 3, respectively. Our results indicate that climate change and more intense extremes are likely to increase the risk of severe pollution events in China. Managing air quality in China in a changing climate will thus become more challenging. 近年来，空气污染每年在中国造成超过100万人死亡，成为公共卫生工作的重点。然而，未来的气候变化可能通过增加增加空气污染暴露的天气条件的频率和持续时间，加剧这种对人类健康的影响。在这里，我们使用气候、空气质量和流行病学模型的组合来评估在变化的气候下，根据代表性浓度路径4.5（RCP4.5）的未来空气污染死亡人数。我们发现，假设污染排放和人口保持在当前水平不变的情况下，气候变化将对中国超过85\%的人口（约55\%的土地面积）的未来空气质量产生不利影响，并且将分别使细颗粒物（PM2.5）和臭氧的人口加权平均浓度增加3\%和4\%。因此，我们估计每年将有额外的12,100和8,900名中国人（95\%置信区间分别为10,300至13,800和2,300至14,700）因PM2.5和臭氧暴露而死亡。 重要的基本气候机制是极端条件的变化，如大气停滞和热浪（分别对死亡率增加的贡献为39\%和6\%）。此外，中国老龄化人口的更大脆弱性将进一步使2050年PM2.5和臭氧的预计死亡人数分别增加1倍和3倍。我们的结果表明，气候变化和更强烈的极端事件可能会增加中国严重污染事件的风险。在气候变化下管理中国的空气质量将变得更具挑战性。},
  keywords = {/unread},
  file = {C:\Users\HuYG0\OneDrive\Papers\2019.Hong.Impacts of climate change on future air quality and human health in China.pdf}
}

