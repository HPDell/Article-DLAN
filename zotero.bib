@article{IrandeganiMohammadi-2019,
  title = {Investigating {{Temporal}} and {{Spatial Effects}} of {{Urban Planning Variables}} on {{Crime Rate}}: {{A GWR}} and {{OLS Based Approach}}},
  shorttitle = {Investigating {{Temporal}} and {{Spatial Effects}} of {{Urban Planning Variables}} on {{Crime Rate}}},
  author = {Irandegani, Z. and Mohammadi, R. and Taleai, M.},
  year = 2019,
  month = oct,
  journal = {The International Archives of the Photogrammetry, Remote Sensing and Spatial Information Sciences},
  volume = {XLII-4/W18},
  pages = {559--564},
  issn = {2194-9034},
  doi = {10.5194/isprs-archives-XLII-4-W18-559-2019},
  urldate = {2023-01-28},
  abstract = {Spatial, temporal, environmental and urban planning variables are some factors effected crime occurrence as a social undesirable phenomenon. In this paper, the effect of urban planning variables (including land use diversity and police station area) and temporal parameters (including daily and weekly time windows) on crime incidence were investigated by doing some spatial-temporal analysis. To tackle this, at first, in order to determine crime clusters, DBSCAN algorithm is utilized. Then by using the Ordinary Least Square (OLS) and Geographically Weighted Regression (GWR) the global effect of urban planning variables on crime spatial clusters are modelled and compared. Finally, the OLS method is used to investigate the effects of temporal variables on crime spatial clusters. The results demonstrate that there is a negative correlation between crime clusters and the police station coverage, and a positive relationship between crime clusters and land-use diversity. Furthermore, increasing the number of police stations in districts with high land-use diversity can result in reducing the crime rate. Also, the result of our temporal analysis shows that the high crime rate was happened at noon and on weekdays. Therefore, increasing the number of police officers at noon and on weekdays in the districts with high land-use diversity is recommended.},
  langid = {english},
  file = {C:\Users\HuYG0\Zotero\storage\8VIIBA9F\2019.Irandegani.Investigating Temporal and Spatial Effects of Urban Planning Variables on Crime Rate A GWR and OLS.pdf}
}

