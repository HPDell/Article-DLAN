  title = {Regression and Time Series Model Selection in Small Samples},
  author = {HURVICH, CLIFFORD M. and TSAI, CHIH-LING},
  year = 1989,
  month = jun,
  journal = {Biometrika},
  volume = {76},
  number = {2},
  pages = {297--307},
  issn = {0006-3444},
  doi = {10.1093/biomet/76.2.297},
  urldate = {2024-06-19},
  abstract = {A bias correction to the Akaike information criterion, AIC, is derived for regression and autoregressive time series models. The correction is of particular use when the sample size is small, or when the number of fitted parameters is a moderate to large fraction of the sample size. The corrected method, called AICC, is asymptotically efficient if the true model is infinite dimensional. Furthermore, when the true model is of finite dimension, AICC is found to provide better model order choices than any other asymptotically efficient method. Applications to nonstationary autoregressive and mixed autoregressive moving average time series models are also discussed.},
  file = {C\:\\Users\\HuYG0\\OneDrive\\Papers\\1989.HURVICH.Regression and time series model selection in small samples.pdf;C\:\\Users\\HuYG0\\Zotero\\storage\\MIMQDKJE\\265326.html}
}

@phdthesis{HuSheng-2025,
  type = {{硕士学位论文}},
  title = {{地理多元流数据的存储及可视化方法}},
  author = {胡, 圣},
  year = 2025,
  address = {武汉},
  doi = {10.27379/d.cnki.gwhdu.2021.001819},
  urldate = {2026-03-02},
  abstract = {物质、信息、能量等在不同地理位置间的移动或交换形成了地理流。基于地理流形成的空间交互网络无处不在,人口迁徙、贸易、国际关系、社交等网络因嵌入地理位置而形成不同主题的地理流网络,地理流网络的挖掘与分析,为国际关系分析、公共卫生防护、城市空间规划、交通交互分析与交通管理等领域的研究提供了新的研究视角和决策支持。地理多元流网络是由不同主题的单元流网络构成,地理单元流网络数据的基本形式可以用OD数据表示,可以借助图结构数据来表达。地理多元流网络的可视化有助于用户直观地发现网络结构和发掘其社团结构等模式,但是在实际使用中,需要考虑地理多元流数据的存储、多维可视化方法、工程实践等关键问题。 本文通过对比图数据库和关系型数据库对全球尺度的OD数据的查询性能,设计了地理多元流数据的存储方法。同时借助地图、图可视化和统计图表,设计了地理单元流和多元流的布局、结构和统计特征可视化方法;最后结合web前后端开发技术开发了地理多元流网络可视化系统。本文的主要研究工作如下: (1)地理多元流数据存储 围绕地理多元流数据的存储与可视化方法的研究主题,收集整理了三种全球尺度的地理流数据,包括:全球航班数据、Twitter人口流动数据、GDELT新闻事件数据。由于原始数据的空间尺度不一,为了构造全球尺度的地理多元流网络,本文对数据进行了清洗、匹配等预处理,将数据聚合到国家层次,然后采用图数据库Neo4j对该地理多元流网络数据进行了存储。此外,本文还利用全球Twitter人口流动数据作为测试数据,对Neo4j与关系型数据库My SQL的查询性能进行了测试与对比分析,结果表明Neo4j对地理多元流网络数据具有更加高效的查询性能。 (2)地理多元流数据可视化 地理流网络数据是一种图网络数据,可以用图可视化的方式进行呈现。然而图中大量边的重叠和交叉会产生视觉混乱,为了优化网络布局,突出网络的布局特征,本文介绍了基于力导引边捆绑的优化布局算法;结合此算法和Map V.js,设计并实现了地理单元流和多元流的网络布局可视化,同时借助图表等信息可视化工具设计并实现了地理单元流和多元流网络的结构和统计特征。 (3)地理多元流可视化系统的设计与实现 本文基于地理多元流数据的存储与可视化方法,结合Flask、Layui、Cesium、Echarts等当前互联网软件开发技术,开发了地理多元流可视化原型系统。对疫情期间的全球航班网络这种地理流数据进行了可视化尝试,并作了简要分析;同时针对疫情期间的全球航班网络与Twitter人口流网络构成的多主题地理多元流网络进行了布局叠加的可视化,对其互作用作了简要的分析。},
  collaborator = {秦, 昆},
  langid = {chinese},
  school = {武汉大学},
  annotation = {album: 基础科学;信息科技\\
CLC: P208\\
dbcode: CMFD\\
dbname: CMFD202501\\
filename: 1021660251.nh\\
major: 地图学与地理信息系统},
  file = {C:\Users\HuYG0\OneDrive\Papers\2025.胡圣.地理多元流数据的存储及可视化方法.pdf}
}

@article{HuSong-2024,
  title = {A Local Indicator of Stratified Power},
  author = {Hu, Jiao and Song, Yongze and Zhang, Tingbin},
  year = 2024,
  month = dec,
  journal = {International Journal of Geographical Information Science},
  volume = {0},
  number = {0},
  pages = {1--19},
  publisher = {Taylor \& Francis},
  issn = {1365-8816},
  doi = {10.1080/13658816.2024.2437811},
  urldate = {2024-12-08},
  abstract = {Spatial stratified heterogeneity measures spatial association by power of determinant (PD) that compares variations within strata and across space. Models based on stratified heterogeneity have been extensively used across various fields to analyze PD from a spatial perspective. However, stratified heterogeneity in the local regions has not been investigated, although it can significantly influence the overall PD measurements in large-scale studies. This study proposes a local indicator of stratified power (LISP) to analyze local spatial stratified association and demonstrate how spatial stratified association changes spatially and in local regions. The LISP model was implemented to examine the local potential determinants of the thickness variations in lake-terminating glaciers of the Greater Himalayas. The results indicate that LISP can reveal spatial association at various local positions, effectively mitigating the underestimation or overestimation of PD values in local regions that are probably missed in global spatial stratified association models. The developed LISP model provides a reliable methodological framework for exploring local spatial associations and identifying local determinants in broad fields.},
  langid = {english},
  keywords = {glacier,local determinants,local power,spatial association,Spatial stratified heterogeneity},
  file = {C:\Users\HuYG0\OneDrive\Papers\Hu.A local indicator of stratified power.pdf}
}

@misc{HuWan-2023,
  type = {{{SSRN Scholarly Paper}}},
  title = {Education Expansion and Income Inequality: Empirical Evidence from {{China}}},
  shorttitle = {Education Expansion and Income Inequality},
  author = {Hu, Xiaoshan and Wan, Guanghua and Zuo, Congmin},
  year = 2023,
  month = dec,
  number = {4667811},
  eprint = {4667811},
  publisher = {Social Science Research Network},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.4667811},
  urldate = {2024-12-15},
  abstract = {Education has long been perceived as a great equalizer, but even with universal rises in schooling years, income distribution worsened world-wide. We propose a method for decomposing the contribution of a variable to the change in inequality into mean, dispersion, and price components. The proposed method is then used to investigate the roles of the education variable in driving down China's wage inequality between 2010 and 2018. We find that (1) education accounted for over 30\% of total wage inequality in 2010 and 2018; (2) 70\% of the overall decline in wage inequality from 2010 to 2018 can be attributed to education expansion, and (3) the 70\% inequality-reducing effect was made up of 95\% benign dispersion and price components and 25\% malign mean component. The benign components are attributable to an improvement in educational equity and a decrease in the college premium. 长期以来，教育被视为一个伟大的平等化工具，但即使在全球范围内受教育年限普遍增加的情况下，收入分配仍然恶化。我们提出了一种方法，将一个变量对不平等变化的贡献分解为均值、离散度和价格成分。然后使用该方法研究教育变量在降低中国 2010 年至 2018 年工资不平等中的作用。我们发现：（1）教育在 2010 年和 2018 年占总工资不平等的 30\%以上；（2）2010 年至 2018 年工资不平等总体下降的 70\%可归因于教育扩展；（3）70\%的不平等减少效应由 95\%的良性离散度和价格成分以及 25\%的恶性均值成分组成。良性成分可归因于教育公平的改善和大学溢价的下降。},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  keywords = {China,Education Expansion,Rate of Return to Education,Wage Inequality},
  file = {C:\Users\HuYG0\OneDrive\Papers\2023.Hu.Education expansion and income inequality empirical evidence from China.pdf}
}

@article{HuWang-2019,
  title = {Which {{Chinese}} Cities Are More Inclusive and Why?},
  author = {Hu, Wanyang and Wang, Rui},
  year = 2019,
  month = mar,
  journal = {Cities},
  volume = {86},
  pages = {51--61},
  issn = {0264-2751},
  doi = {10.1016/j.cities.2018.12.010},
  urldate = {2024-10-25},
  abstract = {China's household registration system allows local governments to control migration by limiting migrants' eligibility to local public services. Many cities exclude migrant residents from important social benefits, which reduces labor mobility and contributes to the socioeconomic gap between migrants and urban natives. This study measures the extent of China's local migration restriction from the perspective of inclusive provision of public services and explains cross-city disparities. We define urban inclusiveness as the extent to which migrants can access social benefits provided locally and construct an urban inclusiveness index using factor analysis. We find significant cross-city differences in urban inclusiveness toward migrants. Statistical analyses suggest that local fiscal capacity and labor demand, instead of cultural tradition, are the major determinants of urban inclusiveness. We further use the gap between the inclusiveness toward high- and low-skilled migrants to measure local skill-based migration selectivity. We find that more developed cities, i.e., cities with larger populations, higher levels of gross regional product per capita, and greater shares of industrial sector, are more selective based on migrants' skills, while cultural openness does not help bring down skill-based selectivity. Our research suggests an instrumental view of migrants in China's urban policy that contributes to social inequality and the lack of labor mobility, which can restrict China's development in the long term.},
  keywords = {China,Inclusive city,Migration,Restriction,Social benefit}
}

@article{HuYu-2025,
  title = {An Entropy and Dimensional Similarity-Based Geographically Weighted Regression ({{EDSGWR}}) Method},
  author = {Hu, Xiaoyu and Yu, Shifeng and Sheng, Yehua},
  year = 2025,
  month = nov,
  journal = {International Journal of Geographical Information Science},
  pages = {1--18},
  publisher = {Taylor \& Francis},
  issn = {1365-8816},
  doi = {10.1080/13658816.2025.2587155},
  urldate = {2026-01-07},
  abstract = {The increasing complexity of spatial data necessitates advanced research into spatial distributions and the interrelationships of geographical phenomena. Classical geographically weighted regression (GWR) methods struggle with abrupt changes in local ranges, such as sudden variations in property prices or pollution levels. This challenge primarily arises because classical GWR models do not account for relationships between the independent variables and their surrounding environmental attributes, limiting their ability to adapt to complex spatial variations. Herein, an entropy-based high-dimensional attribute similarity GWR method---i.e., Entropy and Dimensional Similarity-based Geographically Weighted Regression (EDSGWR)---is proposed to overcome this limitation. This approach dynamically adjusts regression neighborhoods by computing local entropy, refining spatial regression targets for the GWR model. Next, neighborhood contextual data is incorporated into a high-dimensional attribute matrix, where the Hilbert Schmidt independence criterion is used to measure nonlinear dependencies between a target point and its neighbors. These dependencies generate attribute similarity weights, which are then combined with Euclidean spatial weights to form a hybrid model. Finally, Bayesian optimization determines the optimal neighborhood scale and the number of observations in the attribute matrix. Experiments using four open-source spatial datasets demonstrate that EDSGWR outperforms current methods in accuracy, stability, and interpretability, particularly in cases involving abrupt changes and directional data.},
  langid = {english},
  keywords = {attribute similarity,Geographically weighted regression,high dimensional,local entropy},
  file = {C:\Users\HuYG0\OneDrive\Papers\2025.Hu.An entropy and dimensional similarity-based geographically weighted regression (EDSGWR) method.pdf}
}

