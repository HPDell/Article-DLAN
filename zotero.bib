@article{ColakAlexander-2015,
  title = {Analyzing Cell Phone Location Data for Urban Travel: Current Methods, Limitations, and Opportunities},
  shorttitle = {Analyzing Cell Phone Location Data for Urban Travel},
  author = {{\c C}olak, Serdar and Alexander, Lauren P. and Alvim, Bernardo G. and Mehndiratta, Shomik R. and Gonz{\'a}lez, Marta C.},
  year = 2015,
  month = jan,
  journal = {Transportation Research Record},
  volume = {2526},
  number = {1},
  pages = {126--135},
  publisher = {SAGE Publications Inc},
  issn = {0361-1981},
  doi = {10.3141/2526-14},
  urldate = {2025-11-25},
  abstract = {Travelers today use technology that generates vast amounts of data at low cost. These data could supplement most outputs of regional travel demand models. New analysis tools could change how data and modeling are used in the assessment of travel demand. Recent work has shown how processed origin--destination trips, as developed by trip data providers, support travel analysis. Much less has been reported on how raw data from telecommunication providers can be processed to support such an analysis or to what extent the raw data can be treated to extract travel behavior. This paper discusses how cell phone data can be processed to inform a four-step transportation model, with a focus on the limitations and opportunities of such data. The illustrated data treatment approach uses only phone data and population density to generate trip matrices in two metropolitan areas: Boston, Massachusetts, and Rio de Janeiro, Brazil. How to label zones as home- and work-based according to frequency and time of day is detailed. By using the labels (home, work, or other) of consecutive stays, one can assign purposes to trips such as home-based work. The resulting trip pairs are expanded for the total population from census data. Comparable results with existing information reported in local surveys in Boston and existing origin--destination matrices in Rio de Janeiro are shown. The results detail a method for use of passively generated cellular data as a low-cost option for transportation planning.当今旅行者使用能够以低成本生成大量数据的技术。这些数据可以补充大部分区域旅行需求模型的输出。新的分析工具可以改变数据和建模在评估旅行需求方面的应用方式。最近的研究表明，由出行数据提供者开发的处理后的起点-终点行程支持旅行分析。关于如何处理电信提供商的原始数据以支持这种分析，以及原始数据可以被处理到何种程度以提取出行为，报道较少。本文讨论了如何处理手机数据以提供四步交通模型的信息，重点讨论了这些数据的局限性和机遇。所示的数据处理方法仅使用电话数据和人口密度在波士顿马萨诸塞州和巴西里约热内卢这两个大都会区生成行程矩阵。详细介绍了如何根据频率和一天中的时间将区域标记为家庭和工作场所。通过使用连续停留的标签（家庭、工作或其他），可以为行程分配目的，如家庭工作。 从人口普查数据中扩展了生成的出行对。与波士顿本地调查中报告的现有信息以及里约热内卢现有的起点-终点矩阵相比，结果是可比较的。结果详细介绍了一种利用被动生成的手机数据作为交通规划的低成本选择的方法。},
  langid = {english},
  lccn = {4}
}

