@article{SiQiao-2017,
  title = {Performance of Financial Expenditure in {{China}}'s Basic Science and Math Education: Panel Data Analysis Based on {{CCR}} Model and {{BBC}} Model},
  shorttitle = {Performance of Financial Expenditure in China's Basic Science and Math Education},
  author = {Si, Lin-Bo and Qiao, Hua-Yun},
