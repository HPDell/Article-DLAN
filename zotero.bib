  pages = {18--22},
  issn = {1672-4623},
  abstract = {土地是城市发展建设的主要承载体。对城市土地承载压力与潜力的分析评价，可以获知其压力与潜力的空间差异和分布，挖掘土地潜在存量和价值，优化土地资源配置，进而为土地的集约节约利用提供管理和决策信息。选择城市人口、经济、建设和交通4个方面作为建成区土地的主要承载对象，基于对城市生活空间和生产空间的功能划分，分别构建土地承载压力与潜力评价指标体系，基于GIS空间分析方法进行精细的指标计算和测算，利用地理加权主成分模型开展了土地资源承载压力综合评价，获得分析评价的有关数据信息。利用武汉市地理国情普查数据和社会经济数据，对该方法进行了验证。研究表明，该方法可以有效揭示压力和潜力的差异和分布，对建设平衡稳定的自然生态空间体系，引导城市有序发展和土地资源的合理配置，具有重要的现实意义。},
  langid = {chinese},
