@article{ZhangLin-2016,
  title = {On {{Moran}}'s {{I}} Coefficient under Heterogeneity},
  author = {Zhang, Tonglin and Lin, Ge},
  year = 2016,
  month = mar,
  journal = {Computational Statistics \& Data Analysis},
  volume = {95},
  pages = {83--94},
  issn = {0167-9473},
  doi = {10.1016/j.csda.2015.09.010},
  urldate = {2024-05-18},
  abstract = {Moran's I is the most popular spatial test statistic, but its inability to incorporate heterogeneous populations has been long recognized. This article provides a limiting distribution of the Moran's I coefficient which can be applied to heterogeneous populations. The method provides a unified framework of testing for spatial autocorrelation for both homogeneous and heterogeneous populations, thereby resolving a long standing issue for Moran's I. For Poisson count data, a variance adjustment method is provided that solely depends on populations at risk. Simulation results are shown to be consistent with theoretical results. The application of Nebraska breast cancer data shows that the variance adjustment method is simple and effective in reducing type I error rates, which in turn will likely reduce potential misallocation of limited resources.},
  keywords = {/unread,Clustering or clusters,Heterogeneity,Martingale central limit theorem,Moran's  coefficient,Permutation test,Spatial autocorrelation},
  annotation = {TLDR: The application of Nebraska breast cancer data shows that the variance adjustment method is simple and effective in reducing type I error rates, which in turn will likely reduce potential misallocation of limited resources.}
}

