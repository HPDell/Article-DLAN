  keywords = {cultural capital,cultural reproduction,Extracurricular activities,middle school students,propensity score matching},
  file = {C:\Users\HuYG0\OneDrive\Papers\2022.Tan.An active investment in cultural capital structured extracurricular activities and educational succ.pdf}
}

