@article{TranmerSteel-1998,
  title = {Using {{Census Data}} to {{Investigate}} the {{Causes}} of the {{Ecological Fallacy}}},
  author = {Tranmer, M and Steel, D G},
  year = 1998,
  month = may,
  journal = {Environment and Planning A: Economy and Space},
  volume = {30},
  number = {5},
  pages = {817--831},
  publisher = {SAGE Publications Ltd},
  issn = {0308-518X},
  doi = {10.1068/a300817},
  urldate = {2024-05-22},
  abstract = {The authors show how data from the 2\% Sample of Anonymised Records (SAR) can be combined with data from the Small Area Statistics (SAS) database to investigate the causes of the ecological fallacy in an Enumeration District (ED) level analysis. A range of census variables are examined in three `SAR districts' (local authority districts with populations of 120 000 or more, or combinations of contiguous districts with smaller populations) in England. Results of comparable analyses from the 1986 Australian census are also given. The ecological fallacy arises when results from an analysis based on area-level aggregate statistics are incorrectly assumed to apply at the individual level. In general the results are different because individuals in the same area tend to have similar characteristics: a phenomenon known as within-area homogeneity. A statistical model is presented which allows for within-area homogeneity. This model may be used to explain the effects of aggregation on variances, covariances, and correlations. A methodology is introduced which allows aggregate-level statistics to be adjusted by using individual-level information on those variables that explain much of the within-area homogeneity. This methodology appears to be effective in adjusting census data analyses, and the results suggest that the SAR is a valuable source of adjustment information for aggregate data analyses from census and other sources. 作者展示了如何将 2\%匿名记录样本（SAR）的数据与小区域统计（SAS）数据库的数据结合起来，以研究在枚举区（ED）级别分析中生态谬误的原因。在英格兰的三个``SAR 区''（人口为 12 万或以上的地方行政区，或人口较少的相邻区的组合）中，检查了一系列人口普查变量。还给出了 1986 年澳大利亚人口普查的可比分析结果。当基于区域级别的汇总统计数据的分析结果被错误地假定适用于个人级别时，就会出现生态谬误。一般来说，结果是不同的，因为同一区域内的个体往往具有相似的特征：这种现象被称为区域内同质性。提出了一个统计模型，该模型考虑了区域内同质性。该模型可用于解释聚合对方差、协方差和相关性的影响。 引入了一种方法，该方法允许通过使用解释区域内同质性的大部分变量的个体级信息来调整汇总级统计数据。这种方法在调整人口普查数据分析中似乎是有效的，结果表明，SAR 是调整来自人口普查和其他来源的汇总数据分析的宝贵信息来源。},
  langid = {english},
  keywords = {/unread},
  annotation = {TLDR: The authors show how data from the 2\% Sample of Anonymised Records (SAR) can be combined withData from the Small Area Statistics (SAS) database to investigate the causes of the ecological fallacy in an Enumeration District (ED) level analysis and suggest that the SAR is a valuable source of adjustment information for aggregate data analyses from census and other sources.},
  file = {C:\Users\HuYG0\OneDrive\Papers\1998.Tranmer.Using Census Data to Investigate the Causes of the Ecological Fallacy.pdf}
}

@inproceedings{TranNguyen-2016,
