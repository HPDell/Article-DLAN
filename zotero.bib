@article{Lin-2009,
  title = {Intra-Provincial Inequality in Financing Compulsory Education in {{China}}: Exploring the Role of Provincial Leaders (1994--2001)},
  shorttitle = {Intra-Provincial Inequality in Financing Compulsory Education in {{China}}},
  author = {Lin, Tingjin},
  year = 2009,
