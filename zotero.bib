  doi = {10.1073/pnas.2402802121},
  urldate = {2024-12-08},
  abstract = {Scientific datasets play a crucial role in contemporary data-driven research, as they allow for the progress of science by facilitating the discovery of new patterns and phenomena. This mounting demand for empirical research raises important questions on how strategic data utilization in research projects can stimulate scientific advancement. In this study, we examine the hypothesis inspired by the recombination theory, which suggests that innovative combinations of existing knowledge, including the use of unusual combinations of datasets, can lead to high-impact discoveries. Focusing on social science, we investigate the scientific outcomes of such atypical data combinations in more than 30,000 publications that leverage over 5,000 datasets curated within one of the largest social science databases, Interuniversity Consortium for Political and Social Research. This study offers four important insights. First, combining datasets, particularly those infrequently paired, significantly contributes to both scientific and broader impacts (e.g., dissemination to the general public). Second, infrequently paired datasets maintain a strong association with citation even after controlling for the atypicality of dataset topics. In contrast, the atypicality of dataset topics has a much smaller positive impact on citation counts. Third, smaller and less experienced research teams tend to use atypical combinations of datasets in research more frequently than their larger and more experienced counterparts. Last, despite the benefits of data combination, papers that amalgamate data remain infrequent. This finding suggests that the unconventional combination of datasets is an underutilized but powerful strategy correlated with the scientific impact and broader dissemination of scientific discoveries.},
  langid = {english},
  annotation = {TLDR: These findings underscore the potential of datasets combined unconventionally to elevate the impact of scientific discoveries and provide valuable insights for researchers, policymakers, and data curators.},
  file = {C:\Users\HuYG0\OneDrive\Papers\2024.Yu.Does the use of unusual combinations of datasets contribute to greater scientific impact.pdf}
}

@phdthesis{YuShenYue-2023,
  type = {{硕士学位论文}},
  title = {{空间异质性层次非线性混合效应模型及其在流动人口研究中的应用}},
  author = {俞, 沈悦},
  year = 2023,
  doi = {10.27766/d.cnki.gzjcj.2023.000562},
  urldate = {2026-03-01},
  abstract = {随着技术的发展,数据的产生和收集日益繁多,数据的结构信息不断丰富。从方差分析到20世纪80年代的多水平模型,研究者对数据结构的解析不断深入。混合效应模型的提出,为分析多层次数据提供了新视角。与此同时,随着Tobler于1970年提出``地理学第一定律'',即距离越相近的事物相关性越强,地理数据分析中对空间属性的挖掘也在不断深入。层次空间数据既具有层次结构又包含空间属性,是一种信息极其丰富的数据类型。因此,如何充分挖掘其信息并减少参数估计误差成为重要关注点。现有研究对层次空间数据的分析,通常将个体按空间位置划分为数个群体,采用线性回归方法研究不同层级解释变量对响应变量的影响程度,或采用混合效应模型,将空间属性的影响纳入随机效应中,以减小估计误差。以上方法均未充分提取空间属性,存在较多的数据信息丢失。如何更有效地提取层次空间数据的信息,提高估计精度值得深入研究。因此,本文提出一种空间异质性层次非线性混合效应模型,既考虑层次数据中变量之间的非线性影响形式,又从空间相依性和异质性的角度将空间层次纳入模型的求解过程。从模拟研究与实证分析两方面入手,检验该方法的估计效果。在模拟研究中分别对响应变量服从高斯分布、二项分布、泊松分布,不同空间位置个数进行数值实验。在实证分析中将该方法应用于流动人口的研究中,分析个体特征、地区特征对流动人口长期居留意愿的影响,再次验证了本文提出的估计方法在层次空间数据应用上的优势。本文的贡献主要有以下三点:第一,同时考虑了解释变量的非线性影响及空间属性,放宽了多水平线性模型对解释变量线性影响的假定,改进了非线性混合效应模型对数据空间属性的利用,应用更广泛。该模型很好地刻画第一层个体特征的影响形式,挖掘第二层空间群体间的相依性及其特征对响应变量影响的异质性,提高了模型应用的范围与灵活度,提高了估计精度。第二,引入数据驱动的权重融合方法,提高模型拟合优度与参数估计的精度。在空间分析技术上,传统空间权重包括地理距离权重与经济距离权重。社会经济的发展,离不开地区与地区之间的互相影响,距离越近影响越大,社会经济特征越相似地区的影响也更大。传统空间分析一般仅考虑一种距离权重,或将多种地理距离权重按设定的系数进行组合。考虑到有些地区其周边地区虽距离相近但经济社会特征相差较大,有些地区虽距离较远,但经济社会特征相似。因此,本文引入数据驱动的权重融合方法,根据不同空间位置数据的特点,自动识别地理距离权重与经济距...},
  collaborator = {邱, 瑾},
  langid = {chinese},
  school = {浙江财经大学},
  annotation = {major: 应用统计\\
download: 78\\
album: 基础科学;社会科学II辑\\
CLC: O212.1;C922\\
dbcode: CMFD\\
dbname: CMFD202502\\
filename: 1024868527.nh},
  file = {C:\Users\HuYG0\OneDrive\Papers\2023.俞沈悦.空间异质性层次非线性混合效应模型及其在流动人口研究中的应用.pdf}
}

