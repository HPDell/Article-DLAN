@article{ZhouGu-2024,
  title = {Optimizing Urban Population Mapping Grid Size Selection Based on Random Forest Regression},
  author = {Zhou, Yun and Gu, Songwei and Ge, Zhongxi and Li, Yuechen},
  year = 2024,
  journal = {IEEE Geoscience and Remote Sensing Letters},
  volume = {21},
  pages = {1--5},
  doi = {10.1109/LGRS.2024.3354262},
  abstract = {Credible population mapping outcomes are crucial to urban systems across both demographic and socioeconomic sectors. Although the scale effect indicates that an appropriate grid can enhance gridded population estimation, few studies systematically explored the optimal grid size for producing a population layer. We tackled this issue by proposing a novel framework to determine the most suitable cell size. First, we incorporated multiple geospatial datasets, including points of interest (POI), road networks, Luojia1-01 nighttime light image, elevation, and residential land use data. Second, we employed random forest (RF) regression to downscale the urban population into various gridded population layers. We generated a total of 12 population layers with different cell sizes, ranging from 30 to 1000 m. Lastly, we employed ground-truth survey data of the population to evaluate the accuracy. We tested our methodology in central Chongqing, Southwest China. Our results showed that the 100-m grid cell population layer exhibited higher accuracy ( R{$^2$} = 0.59 and p{$<$}0.05 ) compared to the 11 other grid cell sizes and the WorldPop dataset. In general, this study suggests opting for a suitable grid over the finest grid for population prediction models.},
  langid = {english},
  lccn = {3},
  keywords = {/unread}
}

