@article{RimalovaMenafoglio-2020,
  title = {A Permutation Approach to the Analysis of Spatiotemporal Geochemical Data in the Presence of Heteroscedasticity},
  author = {{\v R}{\'i}malov{\'a}, Veronika and Menafoglio, Alessandra and Pini, Alessia and Pechanec, Vil{\'e}m and Fi{\v s}erov{\'a}, Eva},
  year = 2020,
  journal = {Environmetrics},
  volume = {31},
  number = {4},
  pages = {e2611},
  issn = {1099-095X},
  doi = {10.1002/env.2611},
  urldate = {2024-05-18},
  abstract = {This paper proposes a novel nonparametric approach to model and reveal differences in the geochemical properties of the soil, when these are described by space--time measurements collected in a spatial region naturally divided into two parts. The investigation is motivated by a real study on a space--time geochemical data set, consisting of measurements of potassium chloride pH, water pH, and percentage of organic carbon collected during the growing season in the agricultural and forest areas of a site near Brno (Czech Republic). These data are here modeled as spatially distributed functions of time. A permutation approach is introduced to test for the effect of covariates in a spatial functional regression model with heteroscedastic residuals. In this context, the proposed method accounts for the heterogeneous spatial structure of the data by grounding on a permutation scheme for estimated residuals of the functional model. Here, a weighted least squares model is fitted to the observations, leading to asymptotically exchangeable and, thus, permutable residuals. An extensive simulation study shows that the proposed testing procedure outperforms the competitor approaches that neglect the spatial structure, both in terms of power and size. The results of modeling and testing on the case study are shown and discussed.},
  copyright = {\copyright{} 2019 John Wiley \& Sons, Ltd.},
  langid = {english},
  keywords = {edge effect on soil,functional data,functional regression,geostatistics,nonparametric inference},
  file = {C\:\\Users\\HuYG0\\OneDrive\\Papers\\2020.Římalová.A permutation approach to the analysis of spatiotemporal geochemical data in.pdf;C\:\\Users\\HuYG0\\Zotero\\storage\\8PZ3MHC2\\env.html}
}

