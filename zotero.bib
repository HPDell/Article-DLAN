@article{MuWang-2018,
  title = {Estimation and Inference in Spatially Varying Coefficient Models},
  author = {Mu, Jingru and Wang, Guannan and Wang, Li},
  year = 2018,
  journal = {Environmetrics},
  volume = {29},
