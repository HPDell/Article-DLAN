@article{LeeMitchell-2014,
  title = {Controlling for Localised Spatio-Temporal Autocorrelation in Long-Term Air Pollution and Health Studies},
  author = {Lee, Duncan and Mitchell, Richard},
  year = 2014,
  month = dec,
  journal = {Statistical Methods in Medical Research},
  volume = {23},
  number = {6},
  pages = {488--506},
  publisher = {SAGE Publications Ltd STM},
  issn = {0962-2802},
  doi = {10.1177/0962280214527384},
  urldate = {2024-01-25},
  abstract = {摘要 Estimating the long-term health impact of air pollution using an ecological spatio-temporal study design is a challenging task, due to the presence of residual spatio-temporal autocorrelation in the health counts after adjusting for the covariate effects. This autocorrelation is commonly modelled by a set of random effects represented by a Gaussian Markov random field (GMRF) prior distribution, as part of a hierarchical Bayesian model. However, GMRF models typically assume the random effects are globally smooth in space and time, and thus are likely to be collinear to any spatially and temporally smooth covariates such as air pollution. Such collinearity leads to poor estimation performance of the estimated fixed effects, and motivated by this epidemiological problem, this paper proposes new GMRF methodology to allow for localised spatio-temporal smoothing. This means random effects that are either geographically or temporally adjacent are allowed to be autocorrelated or conditionally independent, which allows more flexible autocorrelation structures to be represented. This increased flexibility results in improved fixed effects estimation compared with global smoothing models, which is evidenced by our simulation study. The methodology is then applied to the motivating study investigating the long-term effects of air pollution on respiratory ill health in Greater Glasgow, Scotland between 2007 and 2011. 使用生态时空研究设计来估计空气污染对长期健康影响是一项具有挑战性的任务，因为在调整协变量效应后，健康计数中存在残余的时空自相关性。这种自相关性通常通过一组由高斯马尔可夫随机场（GMRF）先验分布表示的随机效应来建模，作为层次贝叶斯模型的一部分。然而，GMRF模型通常假设随机效应在空间和时间上是全局平滑的，因此很可能与空气污染等空间和时间平滑的协变量具有共线性。这种共线性导致估计的固定效应的估计性能较差，基于这个流行病学问题的动机，本文提出了新的GMRF方法，以允许局部时空平滑。这意味着地理上或时间上相邻的随机效应可以是自相关的或条件独立的，从而可以表示更灵活的自相关结构。 这种增加的灵活性与全局平滑模型相比，可以得到更好的固定效应估计，这一点在我们的模拟研究中得到了证明。然后，该方法被应用于激励研究，研究了2007年至2011年间苏格兰大格拉斯哥地区空气污染对呼吸系统疾病的长期影响。},
  langid = {english},
  keywords = {/unread},
  annotation = {TLDR: This paper proposes new GMRF methodology to allow for localised spatio-temporal smoothing, which means random effects that are either geographically or temporally adjacent are allowed to be autocorrelated or conditionally independent, which results in improved fixed effects estimation compared with global smoothing models.},
  file = {C:\Users\HuYG0\OneDrive\Papers\2014.Lee.Controlling for localised spatio-temporal autocorrelation in long-term air.pdf}
}

