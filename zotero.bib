  doi = {10.3390/jrfm13030055},
  urldate = {2022-12-09},
  abstract = {Against the backdrop of the COVID-19 outbreak, an emergency policy initiative called ``Suspending Classes Without Stopping Learning'' was launched by the Chinese government to continue teaching activities as schools across the country were closed to contain the virus. However, there is ambiguity and disagreement about what to teach, how to teach, the workload of teachers and students, the teaching environment, and the implications for education equity. Possible difficulties that the policy faces include: the weakness of the online teaching infrastructure, the inexperience of teachers (including unequal learning outcomes caused by teachers' varied experience), the information gap, the complex environment at home, and so forth. To tackle the problems, we suggest that the government needs to further promote the construction of the educational information superhighway, consider equipping teachers and students with standardized home-based teaching/learning equipment, conduct online teacher training, include the development of massive online education in the national strategic plan, and support academic research into online education, especially education to help students with online learning difficulties.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {China,COVID-19,emergency management,emergency policy,online teaching,school,Suspending Classes Without Stopping Learning},
  file = {C:\Users\HuYG0\OneDrive\Papers\2020.Zhang.Suspending Classes Without Stopping Learning.pdf}
}

@article{ZhangWolf-2023,
  title = {Rethinking "Causality" in {{Quantitative Human Geography}}},
  author = {Zhang, Jing and Wolf, Levi},
  year = 2023,
  month = aug,
  publisher = {OSF},
  doi = {10.31235/osf.io/7yncm},
  urldate = {2024-03-12},
  abstract = {Causality is at the core of much contemporary discussion in social sciences, philosophy, and computer science---from the establishment of basic definitions of causality to developing methods for causal inference, this discussion is increasingly finding voice within geographical literature. However, geographers have long discussed (and differed) about the role ``causality'' plays in our work. We present a history of contemporary definitions of causality arising from philosophy, and examine how these intellectual currents interact with past and present geographical thinking about causal relations. We focus in particular on how new counterfactual thinking about causality can help re-route inquiry around a well-known impasse: ``laws'' of geography. Then, we outline the kinds of new scholarship enabled by counterfactual causality and contemporary challenges that counterfactual causality faces in spatial analytics. Throughout, we refer interested readers to contemporary work on spatial causal inference, methods useful for scholars interested in analysing causal relationships in geographical systems.},
  langid = {american},
  keywords = {/unread},
  file = {C\:\\Users\\HuYG0\\OneDrive\\Papers\\2023.Zhang.Rethinking causality in Quantitative Human Geography.pdf;C\:\\Users\\HuYG0\\Zotero\\storage\\JD79M9VL\\7yncm.html}
}

