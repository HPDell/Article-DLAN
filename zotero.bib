@article{MaHu-2014,
  title = {Estimating {{Ground-Level PM}} {\textsubscript{2.5}} in {{China Using Satellite Remote Sensing}}},
  author = {Ma, Zongwei and Hu, Xuefei and Huang, Lei and Bi, Jun and Liu, Yang},
  year = 2014,
  month = jul,
  journal = {Environmental Science \& Technology},
  volume = {48},
