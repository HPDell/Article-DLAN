@article{RicciardiSpano-2022,
  title = {Long-{{Term Exposure}} to {{Greenspace}} and {{Cognitive Function}} during the {{Lifespan}}: {{A Systematic Review}}},
  shorttitle = {Long-{{Term Exposure}} to {{Greenspace}} and {{Cognitive Function}} during the {{Lifespan}}},
  author = {Ricciardi, Elisabetta and Spano, Giuseppina and Lopez, Antonella and Tinella, Luigi and Clemente, Carmine and Elia, Giuseppe and Dadvand, Payam and Sanesi, Giovanni and Bosco, Andrea and Caff{\`o}, Alessandro Oronzo},
  year = 2022,
