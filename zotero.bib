  author = {Haelermans, Carla and Korthals, Roxanne and Jacobs, Madelon and {de Leeuw}, Suzanne and Vermeulen, Stan and {van Vugt}, Lynn and Aarts, Bas and {Prokic-Breuer}, Tijana and {van der Velden}, Rolf and {van Wetten}, Sanne and {de Wolf}, Inge},
  editor = {Prado, J{\'e}r{\^o}me},
