@article{HarrisLanfranco-2020,
  title = {Influence of {{Geographical Effects}} in {{Hedonic Pricing Models}} for {{Grass-Fed Cattle}} in {{Uruguay}}},
  author = {Harris, Paul and Lanfranco, Bruno and Lu, Binbin and Comber, Alexis},
  year = 2020,
