  keywords = {ensemble learning,extreme gradient boosting machine,FUZZY INFERENCE SYSTEM,genetic algorithm,GEOGRAPHICALLY WEIGHTED REGRESSION,GIS,Gully erosion,HYBRID,LOGISTIC-REGRESSION,MODELS,NEURAL-NETWORK,OPTIMIZATION,RANDOM FOREST,SOIL-EROSION,spatial modelling},
