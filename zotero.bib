@article{YinAiken-2024,
  title = {A {{Bayesian}} Spatio-Temporal Model of {{COVID-19}} Spread in {{England}}},
  author = {Yin, Xueqing and Aiken, John M. and Harris, Richard and Bamber, Jonathan L.},
  year = 2024,
  month = may,
  journal = {Scientific Reports},
  volume = {14},
  number = {1},
  pages = {10335},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-024-60964-0},
  urldate = {2024-05-08},
  abstract = {Exploring the spatio-temporal variations of COVID-19 transmission and its potential determinants could provide a deeper understanding of the dynamics of disease spread. This study aimed to investigate the spatio-temporal spread of COVID-19 infections in England, and examine its associations with socioeconomic, demographic and environmental risk factors. We obtained weekly reported COVID-19 cases from 7 March 2020 to 26 March 2022 at Middle Layer Super Output Area (MSOA) level in mainland England from publicly available datasets. With these data, we conducted an ecological study to predict the COVID-19 infection risk and identify its associations with socioeconomic, demographic and environmental risk factors using a Bayesian hierarchical spatio-temporal model. The Bayesian model outperformed the ordinary least squares model and geographically weighted regression model in terms of prediction accuracy. The spread of COVID-19 infections over space and time was heterogeneous. Hotspots of infection risk exhibited inconsistent clustering patterns over time. Risk factors found to be positively associated with COVID-19 infection risk were: annual household income [relative risk (RR) = 1.0008, 95\% Credible Interval (CI) 1.0005--1.0012], unemployment rate [RR = 1.0027, 95\% CI 1.0024--1.0030], population density on the log scale [RR = 1.0146, 95\% CI 1.0129--1.0164], percentage of Caribbean population [RR = 1.0022, 95\% CI 1.0009--1.0036], percentage of adults aged 45--64 years old [RR = 1.0031, 95\% CI 1.0024--1.0039], and particulate matter (\$\$\textbackslash text \textbraceleft PM\textbraceright\_\textbraceleft 2.5\textbraceright\$\$) concentrations [RR = 1.0126, 95\% CI 1.0083--1.0167]. The study highlights the importance of considering socioeconomic, demographic, and environmental factors in analysing the spatio-temporal variations of COVID-19 infections in England. The findings could assist policymakers in developing tailored public health interventions at a localised level.},
  copyright = {2024 The Author(s)},
  langid = {english},
  keywords = {/unread,Epidemiology,Risk factors,Statistics},
  annotation = {TLDR: The Bayesian model outperformed the ordinary least squares model and geographically weighted regression model in terms of prediction accuracy and the spread of COVID-19 infections over space and time was heterogeneous.},
  file = {C:\Users\HuYG0\Zotero\storage\4KU7KYQB\2024.Yin.A Bayesian spatio-temporal model of COVID-19 spread in England.pdf}
}

@article{YinDing-2024,
  title = {{{GNNWR}}: An Open-Source Package of Spatiotemporal Intelligent Regression Methods for Modeling Spatial and Temporal Nonstationarity},
  author = {Yin, Ziyu and Ding, Jiale and Liu, Yi and Wang, Ruoxu and Wang, Yige and Chen, Yijun and Qi, Jin and Wu, Sensen and Du, Zhenhong},
  year = 2024,
  journal = {Geoscientific Model Development},
  volume = {null},
  pages = {null},
  doi = {10.5194/gmd-17-8455-2024},
  abstract = {Abstract. Spatiotemporal regression is a crucial method in geography for discerning spatiotemporal nonstationarity in geographical relationships and has found widespread application across diverse research domains. This study implements two innovative spatiotemporal intelligent regression models, i.e., Geographically Neural Network Weighted Regression (GNNWR) and Geographically and Temporally Neural Network Weighted Regression (GTNNWR), which use neural networks to estimate spatiotemporal nonstationarity. Due to the higher accuracy and generalization ability, these models have been widely used in various fields of scientific research. To facilitate the application of GNNWR and GTNNWR in addressing spatiotemporal nonstationary processes, the Python-based package GNNWR has been developed. This article details the implementation of these models and introduces the GNNWR package, enabling users to efficiently apply these cutting-edge techniques. Validation of the package is conducted through two case studies. The first case involves the verification of GNNWR using air quality data from China, while the second employs offshore dissolved silicate concentration data from Zhejiang Province to validate GTNNWR. The results of the case studies underscore the effectiveness of the GNNWR package, yielding outcomes of notable accuracy. This contribution anticipates a significant role for the developed package in supporting future research that will leverage big data and spatiotemporal regression techniques.},
  langid = {english},
  lccn = {2},
  keywords = {/unread},
  annotation = {TLDR: A significant role is expected for the developed package GNNWR in supporting future research that will leverage big data and spatiotemporal regression techniques, as well as supporting future research that will leverage big data and spatiotemporal regression techniques.},
  file = {C:\Users\HuYG0\OneDrive\Papers\2024.Yin.GNNWR an open-source package of spatiotemporal intelligent regression methods for modeling spatial.pdf}
}

