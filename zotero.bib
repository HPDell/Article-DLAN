@article{PypkowskiSykulski-2025,
  title = {Isotropy Testing in Spatial Point Patterns: Nonparametric versus Parametric Replication under Misspecification},
  shorttitle = {Isotropy Testing in Spatial Point Patterns},
  author = {Pypkowski, Jakub J. and Sykulski, Adam M. and Martin, James S.},
