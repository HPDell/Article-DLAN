@article{YinMu-2022,
  title = {Examination-Oriented or Quality-Oriented? {{A}} Question for Fellows of an Alternative Teacher Preparation Program in {{China}}},
  shorttitle = {Examination-Oriented or Quality-Oriented?},
  author = {Yin, Yue Melody and Mu, Guanglun Michael},
