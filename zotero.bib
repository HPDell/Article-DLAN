  file = {C\:\\Users\\HuYG0\\OneDrive\\Papers\\2000.Brunsdon.Geographically Weighted Regression as a Statistical Model.pdf;C\:\\Users\\HuYG0\\Zotero\\storage\\JGPD3ISB\\5975.html}
}

