  lccn = {2},
  keywords = {/unread},
  annotation = {TLDR: A high-resolution population mapping method using the SDGSAT 1 glimmer imager data and deep learning, which significantly reduced the average absolute error and root-mean-square error and outperformed other population spatialization datasets and NTL data by over 30\% and 10\%, respectively, in terms of error reduction.}
}

