}

@article{ChenWang-2022,
  title = {Potential Driving Forces and Probabilistic Health Risks of Heavy Metal Accumulation in the Soils from an E-Waste Area, Southeast {{China}}},
  author = {Chen, Hanrui and Wang, Lu and Hu, Bifeng and Xu, Jianming and Liu, Xingmei},
  year = 2022,
  month = feb,
  journal = {Chemosphere},
  volume = {289},
  pages = {133182},
  publisher = {Pergamon-Elsevier Science Ltd},
  address = {Oxford},
  issn = {0045-6535, 1879-1298},
  doi = {10.1016/j.chemosphere.2021.133182},
  abstract = {The integrated analysis of the distribution characteristics, health risks, and source identification of heavy metals is crucial for formulating prevention and control strategies for soil contamination. In this study, the area around an abandoned electronic waste dismantling center in China was selected as the research area. The probabilistic health risks caused by heavy metals were evaluated by the Monte Carlo simulation. Random forest, partial least squares regression, and generalized linear models were utilized to predict heavy metal distributions and identify the potential driving factors affecting heavy metal accumulation in soil. The relationships of spatial variation between the heavy metal contents and environmental variables were further visualized. The results revealed that cadmium (Cd) and copper (Cu) were the primary soil pollutants in the study area and caused high ecological risks. The probabilistic health risk assessment indicated that the non-carcinogenic and carcinogenic risks for all populations were acceptable. However, children are more susceptible to heavy metal soil contamination than adults. The sensitivity analyses indicated that the total contents of soil heavy metals and soil ingestion rate were the dominant factors affecting human health. The random forest model, with R-2 values of 0.41, 0.65, 0.57, 0.71, and 0.58 for Cd, Cu, Ni, Zn, and Pb, respectively, predicted the heavy metal concentrations better than the other two models. The distance to the nearest industrial enterprise, industrial output, and agricultural chemical input were the main factors affecting Cd, Cu, Zn, and Pb accumulations in the soil, and soil pH and soil parent material were the primary factors influencing Ni accumulation in the soil. The visualization results of the geographically weighted regression model showed a significant relationship between soil heavy metal contents and industrial activity level. This study could be utilized as a reference for policymakers to formulate prevention and control strategies for heavy metal pollution in agricultural areas.},
  langid = {english},
  keywords = {AGRICULTURAL SOILS,AIR-POLLUTION,ARTIFICIAL NEURAL-NETWORK,BIOAVAILABILITY,CONTAMINATION,EXPOSURE,GWR model,Heavy metals,LEAST-SQUARES REGRESSION,Machine learning,Probabilistic health risk,SOURCE APPORTIONMENT,Source identification,SOURCE IDENTIFICATION,ZN SMELTER},
  annotation = {Web of Science ID: WOS:000734134500009}
}

@article{ChenXie-2022,
  title = {Recurrent Origin--Destination Network for Exploration of Human Periodic Collective Dynamics},
  author = {Chen, Xiaojian and Xie, Jiayi and Xiao, Changjiang and Lu, Binbin and Shan, Jie},
  year = 2022,
  journal = {Transactions in GIS},
  volume = {26},
  number = {1},
  pages = {317--340},
  issn = {1467-9671},
  doi = {10.1111/tgis.12849},
  urldate = {2022-09-13},
  abstract = {While daily periodic movements of individuals have been widely studied, their collective dynamics are not understood. To capture periodic collective dynamics, this article represents individual daily movements as a time series of directed weighted origin--destination (OD) networks, and proposes an approach to identify a sub-network called the ``recurrent OD network'', which contains frequent edges appearing in each day. Taxi trajectory data over a period of 6 months in Wuhan, China are used for the case study. Here, we extracted the recurrent OD networks for each 2-h period on a given day, and compared them with the corresponding ``major OD network'' defined by both frequent and infrequent edges. Results show that the recurrent OD networks coincidentally exhibit spatially localized community structures and distinctive patterns of inflow and outflow for each region within a day. Overall, both methodology and findings in this study might make significant contributions in a range of fields, such as urban planning, regional economic development, and infectious disease control.},
  langid = {english},
  file = {C\:\\Users\\HuYG0\\OneDrive\\Papers\\2022.Chen.Recurrent origin–destination network for exploration of human periodic.pdf;C\:\\Users\\HuYG0\\Zotero\\storage\\HNSBSPM4\\tgis.html}
}

@article{ChenXu-2016,
  title = {Understanding Temporal Patterns and Characteristics of Air Quality in {{Beijing}}: {{A}} Local and Regional Perspective},
  shorttitle = {Understanding Temporal Patterns and Characteristics of Air Quality in {{Beijing}}},
  author = {Chen, Ziyue and Xu, Bing and Cai, Jun and Gao, Bingbo},
  year = 2016,
