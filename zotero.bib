  abstract = {Consider a stationary random field \textbraceleft Xn\textbraceright{} indexed by N-dimensional lattice points, where \textbraceleft Xn\textbraceright{} takes values in Rd. An important problem in spatial statistics is the estimation of the regression of \textbraceleft Xn\textbraceright{} on the values of the random field at surrounding sites, say, Xn1,\dots,Xn{$\ell$}. Note that (Xn1,\dots,Xn{$\ell$}) is a {$\ell$}d-dimensional vector. Assume the existence of the regression function r(x)=E\textbraceleft{$\phi$}(Xn)\textbar (Xn1,\dots,Xn{$\ell$})=x\textbraceright,where {$\phi$} is a continuous real-valued function which is not necessarily bounded, and x{$\in$}R{$\ell$}d. Kernel-type estimators of the regression function r(x) are investigated. They are shown to converge uniformly on compact sets under general conditions. In addition, they can attain the optimal rates of convergence in L{$\infty$}. The results hold for a large class of spatial processes.},
  keywords = {Bandwidth,Kernel,Random field,Regression estimation},
