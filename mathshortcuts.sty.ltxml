DefMacro('\condvar{}{}', '\var\left({#1}\middle|{#2}\right)');
DefMacro('\hfrac{}{}', '\left.{#1}\middle/{#2}\right.');

DefMacro('\diagnostic{}[]{}', sub {
    my ($gullet, $name, $lab, $value) = @_;
    my @tokens = (T_BEGIN, $name->unlist);
    if (defined $lab && !IsEmpty($lab)) {
        push @tokens, T_SUB, T_BEGIN, $lab->unlist, T_END;
    }
    push @tokens, T_END;
    if ($value->toString =~ /-?\d+(\.\d+)?(e\d+)?/) {
        push @tokens, T_OTHER('='), $value->unlist;
    }
    return (LookupValue('IN_MATH')
        ? Tokens(@tokens)
        : Tokens(T_CS('\ensuremath'), T_BEGIN, @tokens, T_END));
});

DefMacro('\rsquared[]{}', '\diagnostic{R^2}[#1]{#2}');
DefMacro('\CV[]{}', '\diagnostic{\mathrm{CV}}[#1]{#2}');
DefMacro('\AIC[]{}', '\diagnostic{\mathrm{AIC}}[#1]{#2}');
DefMacro('\AICc[]{}', '\diagnostic{\mathrm{AIC}_c}[#1]{#2}');

1;