\NewDocumentCommand{\rvec}{ m O{} }{%
\mathchoice{\left(#1\right)#2}%
  {(#1)#2}%
  {(#1)#2}%
  {(#1)#2}%
}
\NewDocumentCommand{\cvec}{ m O{} }{{\rvec{#1}[#2]}\T}
\NewDocumentCommand{\set}{ m O{}}{%
  \IfNoValueTF{#2}{%
    \left\{{#1}\right\}%
  }{%
    \left\{{#1}\middle|{#2}\right\}%
  }%
}%

